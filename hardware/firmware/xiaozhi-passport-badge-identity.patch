+private:
+    lv_obj_t* identity_label_ = nullptr;
+    lv_obj_t* name_label_ = nullptr;
+    lv_obj_t* sub_label_ = nullptr;
+    lv_obj_t* divider_ = nullptr;
+    lv_obj_t* company_label_ = nullptr;
+    lv_obj_t* rec_dot_ = nullptr;
+    lv_obj_t* rec_label_ = nullptr;
+    lv_obj_t* batt_label_ = nullptr;
+    esp_timer_handle_t refresh_timer_ = nullptr;
+    std::string shown_text_;
+    bool badge_shown_ = false;
+    bool rec_shown_ = false;
+    int64_t rec_start_us_ = 0;
+
+    void SetHidden(lv_obj_t* obj, bool hidden) {
+        if (obj == nullptr) {
+            return;
+        }
+        if (hidden) {
+            lv_obj_add_flag(obj, LV_OBJ_FLAG_HIDDEN);
+        } else {
+            lv_obj_remove_flag(obj, LV_OBJ_FLAG_HIDDEN);
+        }
+    }
+
+    void RefreshDisplay() {
+        auto& app = Application::GetInstance();
+        DeviceState state = app.GetDeviceState();
+        // Badge face stays visible in the working states (idle + conversation)
+        // so the employee info never disappears while recording; system phases
+        // (boot/activation/upgrade) still own the screen.
+        bool badge_state = state == kDeviceStateIdle || state == kDeviceStateListening ||
+                           state == kDeviceStateSpeaking;
+        bool recording = state == kDeviceStateListening || state == kDeviceStateSpeaking;
+        BadgeIdentity bi = GetBadgeIdentity();
+        bool want_badge = badge_state && bi.valid;
+
+        DisplayLockGuard lock(this);
+
+        // Badge face (persistent in working states).
+        if (!want_badge) {
+            if (badge_shown_) {
+                badge_shown_ = false;
+                SetHidden(identity_label_, true);
+                SetHidden(name_label_, true);
+                SetHidden(sub_label_, true);
+                SetHidden(divider_, true);
+                SetHidden(company_label_, true);
+            }
+        } else if (!badge_shown_ || bi.text != shown_text_) {
+            badge_shown_ = true;
+            shown_text_ = bi.text;
+            bool structured = !bi.name.empty();
+            SetHidden(identity_label_, structured);
+            SetHidden(name_label_, !structured);
+            SetHidden(sub_label_, !structured);
+            SetHidden(divider_, !(structured && !bi.company.empty()));
+            SetHidden(company_label_, !(structured && !bi.company.empty()));
+            if (structured) {
+                lv_label_set_text(name_label_, bi.name.c_str());
+                std::string sub;
+                if (!bi.employee_id.empty()) {
+                    sub += bi.employee_id;
+                }
+                if (!bi.title.empty()) {
+                    if (!sub.empty()) {
+                        sub += "\n";
+                    }
+                    sub += bi.title;
+                }
+                lv_label_set_text(sub_label_, sub.c_str());
+                lv_label_set_text(company_label_, bi.company.c_str());
+            } else {
+                lv_label_set_text(identity_label_, bi.text.c_str());
+            }
+        }
+
+        // Recording indicator with elapsed time (bottom-left).
+        if (!recording) {
+            if (rec_shown_) {
+                rec_shown_ = false;
+                SetHidden(rec_dot_, true);
+                SetHidden(rec_label_, true);
+            }
+        } else {
+            int64_t now = esp_timer_get_time();
+            if (!rec_shown_) {
+                rec_shown_ = true;
+                rec_start_us_ = now;
+            }
+            int elapsed = (int)((now - rec_start_us_) / 1000000LL);
+            char buf[32];
+            snprintf(buf, sizeof(buf), "%02d:%02d", elapsed / 60, elapsed % 60);
+            lv_label_set_text(rec_label_, buf);
+            SetHidden(rec_dot_, false);
+            SetHidden(rec_label_, false);
+        }
+
+        // Battery percentage (bottom-right), read from the CW2017 fuel gauge.
+        int level = 0;
+        bool charging = false, discharging = false;
+        if (Board::GetInstance().GetBatteryLevel(level, charging, discharging)) {
+            char buf[16];
+            snprintf(buf, sizeof(buf), "%d%%", level);
+            lv_label_set_text(batt_label_, buf);
+            SetHidden(batt_label_, false);
+        } else {
+            SetHidden(batt_label_, true);
+        }
+    }
+};
