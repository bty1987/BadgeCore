+// Badge mode: whenever the server has pushed identity data (Ota "identity"
+// section or WS message), show a persistent name-badge face — structured
+// fields render as a hierarchy (name, dim id/title, divider, company), plain
+// text renders as-is. The face stays up during conversations; a red recording
+// indicator with elapsed time sits at the bottom-left and the battery
+// percentage at the bottom-right. The robot avatar is made permanently
+// invisible.
+class AiPassportDisplay : public SpiLcdDisplay {
+public:
+    using SpiLcdDisplay::SpiLcdDisplay;
+
+    void SetupUI() override {
+        SpiLcdDisplay::SetupUI();
+        DisplayLockGuard lock(this);
+
+        // Badge mode: no robot avatar. Keep the upstream-owned objects alive —
+        // LcdDisplay::SetTheme styles emoji_label_ without a null check, so
+        // deleting it crashes the next theme refresh (boot loop via OTA
+        // rollback). Hide + full transparency instead: SetEmotion may unhide
+        // the label, but opacity keeps it invisible in every state.
+        if (emoji_label_ != nullptr) {
+            lv_obj_add_flag(emoji_label_, LV_OBJ_FLAG_HIDDEN);
+            lv_obj_set_style_opa(emoji_label_, LV_OPA_TRANSP, 0);
+        }
+        if (emoji_image_ != nullptr) {
+            lv_obj_set_style_opa(emoji_image_, LV_OPA_TRANSP, 0);
+        }
+
+        auto screen = lv_screen_active();
+        auto lvgl_theme = static_cast<LvglTheme*>(current_theme_);
+        lv_color_t text_color = lvgl_theme->text_color();
+
+        // Free-text badge face (fallback when no structured name is given).
+        identity_label_ = lv_label_create(screen);
+        lv_obj_set_width(identity_label_, LV_HOR_RES - 24);
+        lv_label_set_long_mode(identity_label_, LV_LABEL_LONG_WRAP);
+        lv_obj_set_style_text_align(identity_label_, LV_TEXT_ALIGN_CENTER, 0);
+        lv_obj_align(identity_label_, LV_ALIGN_CENTER, 0, -10);
+        lv_label_set_text(identity_label_, "");
+        lv_obj_add_flag(identity_label_, LV_OBJ_FLAG_HIDDEN);
+
+        // Structured badge face: name over dim id/title, divider, company.
+        // Name uses the runtime theme font (common charset — renders any
+        // Chinese name). The 30px built-in font only covers the basic charset
+        // (no arbitrary hanzi) and the full 30px common font (2.5MB) exceeds
+        // the 2MB assets partition, so hierarchy is expressed via opacity and
+        // letter spacing rather than glyph size.
+        name_label_ = lv_label_create(screen);
+        lv_obj_set_style_text_letter_space(name_label_, 4, 0);
+        lv_obj_set_style_text_align(name_label_, LV_TEXT_ALIGN_CENTER, 0);
+        lv_obj_align(name_label_, LV_ALIGN_CENTER, 0, -22);
+        lv_label_set_text(name_label_, "");
+        lv_obj_add_flag(name_label_, LV_OBJ_FLAG_HIDDEN);
+
+        sub_label_ = lv_label_create(screen);
+        lv_obj_set_style_text_align(sub_label_, LV_TEXT_ALIGN_CENTER, 0);
+        lv_obj_set_style_text_opa(sub_label_, LV_OPA_60, 0);
+        lv_obj_align(sub_label_, LV_ALIGN_CENTER, 0, 22);
+        lv_label_set_text(sub_label_, "");
+        lv_obj_add_flag(sub_label_, LV_OBJ_FLAG_HIDDEN);
+
+        divider_ = lv_obj_create(screen);
+        lv_obj_set_size(divider_, 120, 1);
+        lv_obj_set_style_bg_color(divider_, text_color, 0);
+        lv_obj_set_style_bg_opa(divider_, LV_OPA_30, 0);
+        lv_obj_set_style_border_width(divider_, 0, 0);
+        lv_obj_set_style_radius(divider_, 0, 0);
+        lv_obj_align(divider_, LV_ALIGN_CENTER, 0, 58);
+        lv_obj_add_flag(divider_, LV_OBJ_FLAG_HIDDEN);
+
+        company_label_ = lv_label_create(screen);
+        lv_obj_set_style_text_align(company_label_, LV_TEXT_ALIGN_CENTER, 0);
+        lv_obj_set_style_text_opa(company_label_, LV_OPA_50, 0);
+        lv_obj_align(company_label_, LV_ALIGN_CENTER, 0, 76);
+        lv_label_set_text(company_label_, "");
