+
     // Signal completion to main loop
     xEventGroupSetBits(event_group_, MAIN_EVENT_ACTIVATION_DONE);
 }
 
+void Application::BadgeMaintenanceTick() {
+    // Only touch OTA when idle so upgrades never interrupt a conversation.
+    if (GetDeviceState() != kDeviceStateIdle) {
+        return;
+    }
+    if (!ota_) {
+        ota_ = std::make_unique<Ota>();
+    }
+    auto check = ota_->CheckVersion();
+    if (!check) {
+        ESP_LOGW(TAG, "[Badge] OTA refresh failed, will retry next tick");
+        return;
+    }
+    if (ota_->HasNewVersion()) {
+        auto display = Board::GetInstance().GetDisplay();
+        std::string notice =
+            std::string(Lang::Strings::UPGRADING) + " " + ota_->GetFirmwareVersion();
+        display->ShowNotification(notice.c_str(), 10000);
+        ESP_LOGI(TAG, "[Badge] New firmware %s, auto-upgrading",
+                 ota_->GetFirmwareVersion().c_str());
+        UpgradeFirmware(ota_->GetFirmwareUrl(), ota_->GetFirmwareVersion());
+    }
+}
