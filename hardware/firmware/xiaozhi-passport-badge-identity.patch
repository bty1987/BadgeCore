 #include <vector>
 
 #define TAG "Ota"
 
+static std::mutex g_identity_mutex;
+static BadgeIdentity g_badge_identity;
+
+BadgeIdentity GetBadgeIdentity() {
+    std::lock_guard<std::mutex> lock(g_identity_mutex);
+    return g_badge_identity;
+}
+
+static std::string GetObjString(const cJSON* obj, const char* field) {
+    const cJSON* item = cJSON_GetObjectItem(obj, field);
+    return (cJSON_IsString(item) && item->valuestring[0] != '\0') ? std::string(item->valuestring)
+                                                                  : std::string();
+}
+
+static void ApplyBadgeIdentity(const BadgeIdentity& bi) {
+    {
+        std::lock_guard<std::mutex> lock(g_identity_mutex);
+        if (bi.valid && bi.text == g_badge_identity.text &&
+            bi.company == g_badge_identity.company) {
+            return;  // unchanged
+        }
+        g_badge_identity = bi;
+    }
+    // Persist as a small JSON object (NVS, survives reboots).
+    cJSON* root = cJSON_CreateObject();
+    auto add = [&root](const char* key, const std::string& value) {
+        if (!value.empty()) {
+            cJSON_AddStringToObject(root, key, value.c_str());
+        }
+    };
+    add("text", bi.text);
+    add("name", bi.name);
+    add("employee_id", bi.employee_id);
+    add("title", bi.title);
+    add("company", bi.company);
+    char* printed = cJSON_PrintUnformatted(root);
+    std::string json = printed != nullptr ? printed : "";
+    cJSON_free(printed);
+    cJSON_Delete(root);
+    if (!json.empty()) {
+        Settings settings("identity", true);
+        settings.SetString("json", json);
+    }
+    ESP_LOGI(TAG, "Badge identity updated (%d bytes)", (int)json.size());
+}
+
+void SetBadgeIdentityFromJson(const cJSON* obj) {
+    if (!cJSON_IsObject(obj)) {
+        return;
+    }
+    BadgeIdentity bi;
+    bi.text = GetObjString(obj, "text");
+    bi.name = GetObjString(obj, "name");
+    bi.employee_id = GetObjString(obj, "employee_id");
+    bi.title = GetObjString(obj, "title");
+    bi.company = GetObjString(obj, "company");
+
+    // Assemble the free-form fallback text from structured fields.
+    if (bi.text.empty()) {
+        const std::string* kLines[] = {&bi.name, &bi.employee_id, &bi.title};
+        for (const std::string* line : kLines) {
+            if (!line->empty()) {
+                if (!bi.text.empty()) {
+                    bi.text += "\n";
+                }
+                bi.text += *line;
+            }
+        }
+    }
+    bi.valid = !bi.text.empty();
+    ApplyBadgeIdentity(bi);
+}
+
