+// Badge identity delivered by the server via the OTA "identity" section or the
+// WS {"type":"identity", ...} message. Supported fields: text (free-form
+// fallback) or name / employee_id / title / company (structured badge layout).
+// Persisted in NVS across reboots; board UIs render it while the device is idle.
+struct BadgeIdentity {
+    bool valid = false;
+    std::string text;  // free-form fallback (also auto-assembled from fields)
+    std::string name;
+    std::string employee_id;
+    std::string title;
+    std::string company;
+};
+
+// Returns a copy (written by the OTA/protocol task, read by the LVGL task).
+BadgeIdentity GetBadgeIdentity();
+
+// Extract fields from a JSON object (the identity section itself, or the WS
+// message root) and store them; no-op when nothing changed.
+void SetBadgeIdentityFromJson(const cJSON* obj);
