+    esp_timer_create_args_t badge_timer_args = {};
+    badge_timer_args.callback = [](void* ctx) {
+        static_cast<Application*>(ctx)->Schedule([ctx]() {
+            static_cast<Application*>(ctx)->BadgeMaintenanceTick();
+        });
+    };
+    badge_timer_args.arg = this;
+    badge_timer_args.name = "badge_maint";
+    ESP_ERROR_CHECK(esp_timer_create(&badge_timer_args, &badge_maintenance_timer_));
