+    void SetScreenSleep(bool sleep) {
+        if (screen_slept_.exchange(sleep) == sleep) {
+            return;
+        }
+        idle_seconds_ = 0;
+        after_conversation_ = false;
+        ApplyBacklight();
+        ESP_LOGI(TAG, "Screen %s", sleep ? "sleep (device keeps running)" : "wake");
+    }
