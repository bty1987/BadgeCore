# 登录态与个人数据，严禁入库
**/profile/
tools/browser-drive/

# 依赖与构建产物
node_modules/
dist/
build/
__pycache__/

# 日志与临时文件
*.log
*.tmp
.DS_Store
Thumbs.db

# 大型原始录音（按需放行）
sessions/
*.wav
*.opus
*.ogg

# IDE
.idea/
.vscode/

# 迁移残留（禁止回写）
*.bak

# 云 ASR 凭据（严禁入库）
hardware/receiver/asr.config.json
*.pcm

# 工牌身份显示（个人数据，入库走 badge-identity.example.json）
hardware/receiver/badge-identity.json

# 固件自分发产物（编译产物不入库）
hardware/receiver/firmware/

# 后台数据库与运行数据
server/data/
research/code/

